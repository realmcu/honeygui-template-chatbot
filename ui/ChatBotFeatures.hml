<?xml version="1.0" encoding="UTF-8"?>
<hml>
    <meta>
        <project name="ChatBotFeatures" appId="com.honeygui.chatbot" resolution="480X320" minSdk="API 2: HoneyGUI V1.1.0" pixelMode="ARGB8888" />
        <author name="HoneyGUI Design" />
    </meta>
    <view>
        <hg_view id="ChatBotFeaturesView" x="0" y="0" width="480" height="320" backgroundColor="#000000" entry="true" zIndex="0">
            <events>
                <event type="onSwipeRight">
                    <action type="switchView" target="ChatBotTemplateMainView" switchOutStyle="SWITCH_OUT_TO_RIGHT_USE_TRANSLATION" switchInStyle="SWITCH_IN_FROM_LEFT_USE_TRANSLATION" />
                </event>
                <event type="onSwipeLeft">
                    <action type="switchView" target="ChatBotSettingsView" switchOutStyle="SWITCH_OUT_TO_LEFT_USE_TRANSLATION" switchInStyle="SWITCH_IN_FROM_RIGHT_USE_TRANSLATION" />
                </event>
            </events>
            <hg_image id="hg_image_1768984721134_2dsw" x="0" y="50" width="480" height="270" src="assets/chatbot_bg.png" zIndex="0" />
            <hg_rect id="headerBg2" x="0" y="0" width="480" height="50" fillColor="#4A90E2" borderRadius="0" zIndex="1" />
            <hg_label id="headerTitle2" x="0" y="12" width="480" height="26" color="#FFFFFF" hAlign="CENTER" vAlign="MID" text="AI Features" fontSize="20" fontFile="/font/sf_compact_text_medium.otf" fontType="bitmap" zIndex="2" />
            <hg_rect id="weatherCardBg" x="20" y="70" width="140" height="110" fillColor="#FFFFFF" borderRadius="12" zIndex="3" />
            <hg_label id="weatherTitle" x="30" y="145" width="120" height="20" color="#2C3E50" hAlign="CENTER" vAlign="MID" text="Weather" fontSize="16" fontFile="/font/sf_compact_text_medium.otf" fontType="bitmap" zIndex="4" />
            <hg_rect id="calendarCardBg" x="170" y="70" width="140" height="110" fillColor="#FFFFFF" borderRadius="12" zIndex="5" />
            <hg_label id="calendarTitle" x="180" y="145" width="120" height="20" color="#2C3E50" hAlign="CENTER" vAlign="MID" text="Calendar" fontSize="16" fontFile="/font/sf_compact_text_medium.otf" fontType="bitmap" zIndex="6" />
            <hg_rect id="remindersCardBg" x="320" y="70" width="140" height="110" fillColor="#FFFFFF" borderRadius="12" zIndex="7" />
            <hg_label id="remindersTitle" x="330" y="145" width="120" height="20" color="#2C3E50" hAlign="CENTER" vAlign="MID" text="Reminders" fontSize="16" fontFile="/font/sf_compact_text_medium.otf" fontType="bitmap" zIndex="8" />
            <hg_rect id="alarmCardBg" x="20" y="190" width="140" height="110" fillColor="#FFFFFF" borderRadius="12" zIndex="9" />
            <hg_label id="alarmTitle" x="30" y="265" width="120" height="20" color="#2C3E50" hAlign="CENTER" vAlign="MID" text="Alarm" fontSize="16" fontFile="/font/sf_compact_text_medium.otf" fontType="bitmap" zIndex="10" />
            <hg_rect id="newsCardBg" x="170" y="190" width="140" height="110" fillColor="#FFFFFF" borderRadius="12" zIndex="11" />
            <hg_label id="newsTitle" x="180" y="265" width="120" height="20" color="#2C3E50" hAlign="CENTER" vAlign="MID" text="News" fontSize="16" fontFile="/font/sf_compact_text_medium.otf" fontType="bitmap" zIndex="12" />
            <hg_rect id="musicCardBg" x="320" y="190" width="140" height="110" fillColor="#FFFFFF" borderRadius="12" zIndex="13" />
            <hg_label id="musicTitle" x="330" y="265" width="120" height="20" color="#2C3E50" hAlign="CENTER" vAlign="MID" text="Music" fontSize="16" fontFile="/font/sf_compact_text_medium.otf" fontType="bitmap" zIndex="14" />
            <hg_image id="hg_image_1768816325527_mptv" x="65" y="90" width="100" height="100" transform="{&quot;scaleX&quot;:0.5,&quot;scaleY&quot;:0.5}" src="assets/feature/app_weather_icon.png" zIndex="15" />
            <hg_image id="hg_image_1768819088485_lblv" x="214" y="90" width="100" height="100" transform="{&quot;scaleX&quot;:0.5,&quot;scaleY&quot;:0.5}" src="assets/feature/app_calendar_icon.png" zIndex="16" />
            <hg_image id="hg_image_1768819143830_f1hq" x="363" y="90" width="100" height="100" transform="{&quot;scaleX&quot;:0.5,&quot;scaleY&quot;:0.5}" src="assets/feature/app_reminders_icon.png" zIndex="17" />
            <hg_image id="hg_image_1768819164889_03ph" x="65" y="209" width="100" height="100" transform="{&quot;scaleX&quot;:0.5,&quot;scaleY&quot;:0.5}" src="assets/feature/app_alarm_clock_icon.png" zIndex="18" />
