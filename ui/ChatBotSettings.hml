                    <hg_label id="languageLabel" x="35" y="5" width="200" height="50" color="#FFFFFF" hAlign="LEFT" vAlign="MID" text="Language" fontSize="16" fontFile="/font/Inter24pt-Medium.ttf" fontType="bitmap" zIndex="1" />
