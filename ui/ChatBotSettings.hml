<?xml version="1.0" encoding="UTF-8"?>
<hml>
    <meta>
        <project name="ChatBotSettings" appId="com.honeygui.chatbot" resolution="480X320" minSdk="API 2: HoneyGUI V1.1.0" pixelMode="ARGB8888" />
