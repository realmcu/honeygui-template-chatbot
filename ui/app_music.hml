<?xml version="1.0" encoding="UTF-8"?>
<hml>
    <meta>
        <project name="app_music" appId="com.honeygui.chatbot" resolution="480X320" minSdk="API 2: HoneyGUI V1.1.0" pixelMode="ARGB8888" />
        <author name="Anonymous" />
    </meta>
    <view>
        <hg_view id="app_musicView" x="0" y="0" width="480" height="320" backgroundColor="#000000" entry="false" zIndex="0">
            <events>
                <event type="onKeyShortPress" keyName="Home">
                    <action type="switchView" target="ChatBotTemplateMainView" switchOutStyle="SWITCH_OUT_ANIMATION_FADE" switchInStyle="SWITCH_IN_ANIMATION_FADE" />
                </event>
                <event type="onKeyShortPress" keyName="Menu">
                    <action type="switchView" target="ChatBotFeaturesView" switchOutStyle="SWITCH_OUT_ANIMATION_FADE" switchInStyle="SWITCH_IN_ANIMATION_FADE" />
                </event>
            </events>
            <hg_image id="hg_image_music_bg" x="0" y="0" width="480" height="320" src="assets/music/music_bg.png" blendMode="IMG_SRC_OVER_MODE" zIndex="0" />
            <hg_image id="hg_image_music_album" x="27" y="12" width="200" height="247" src="assets/music/music_album.png" blendMode="IMG_SRC_OVER_MODE" zIndex="1" />
            <hg_label id="hg_label_song" x="27" y="205" width="200" height="24" hAlign="CENTER" vAlign="MID" color="#ffffff" letterSpacing="0" lineSpacing="0" wordWrap="false" wordBreak="false" text="Dreamland" fontFile="/font/Inter24pt-Medium.ttf" fontSize="22" zIndex="2" />
            <hg_label id="hg_label_singer" x="27" y="227" width="200" height="24" hAlign="CENTER" vAlign="MID" color="#afafb1" letterSpacing="0" lineSpacing="0" wordWrap="false" wordBreak="false" text="Glass Animals" fontFile="/font/Inter24pt-Medium.ttf" fontSize="22" zIndex="3" />
            <hg_list id="hg_list_lyrics" x="250" y="0" width="200" height="320" itemWidth="200" itemHeight="60" space="0" direction="VERTICAL" style="LIST_CLASSIC" cardStackLocation="0" noteNum="7" offset="0" outScope="0" autoAlign="true" inertia="true" loop="false" createBar="false" enableAreaDisplay="false" keepNoteAlive="false" showOverflow="true" zIndex="4" showOverflow="true">
                <hg_list_item id="hg_list_lyrics_item_0" x="0" y="0" width="200" height="60" index="0" zIndex="0">
                    <hg_label id="hg_label_lyrics_0" x="0" y="10" width="200" height="45" hAlign="LEFT" vAlign="TOP" color="#ffffff" letterSpacing="0" lineSpacing="3" wordWrap="true" wordBreak="true" text="Slipping through dreamland like a tourist" fontFile="/font/Inter24pt-Medium.ttf" fontSize="20" fontType="vector" zIndex="1" />
                </hg_list_item>
                <hg_list_item id="hg_list_lyrics_item_1" x="0" y="60" width="200" height="60" index="1" zIndex="1">
                    <hg_label id="hg_label_lyrics_1" x="0" y="10" width="200" height="45" hAlign="LEFT" vAlign="TOP" color="#ffffff" letterSpacing="0" lineSpacing="3" wordWrap="true" wordBreak="true" text="Pulling down backstreets deep in your head" fontFile="/font/Inter24pt-Medium.ttf" fontSize="20" zIndex="1" />
                </hg_list_item>
                <hg_list_item id="hg_list_lyrics_item_2" x="0" y="120" width="200" height="60" index="2" zIndex="2">
                    <hg_label id="hg_label_lyrics_2" x="0" y="10" width="200" height="45" hAlign="LEFT" vAlign="TOP" color="#FFFFFF" letterSpacing="0" lineSpacing="3" wordWrap="true" wordBreak="true" text="Slipping through dreamland like a tourist" fontFile="/font/Inter24pt-Medium.ttf" fontSize="20" zIndex="1" />
                </hg_list_item>
                <hg_list_item id="hg_list_lyrics_item_3" x="0" y="180" width="200" height="60" index="3" zIndex="3">
                    <hg_label id="hg_label_lyrics_3" x="0" y="10" width="200" height="45" hAlign="LEFT" vAlign="TOP" color="#FFFFFF" letterSpacing="0" lineSpacing="3" wordWrap="true" wordBreak="true" text="You&#39;ve had too much of the digital love" fontFile="/font/Inter24pt-Medium.ttf" fontSize="20" zIndex="1" />
                </hg_list_item>
                <hg_list_item id="hg_list_lyrics_item_4" x="0" y="240" width="200" height="60" index="4" zIndex="4">
                    <hg_label id="hg_label_lyrics_4" x="0" y="10" width="200" height="45" hAlign="LEFT" vAlign="TOP" color="#ffffff" letterSpacing="0" lineSpacing="3" wordWrap="true" wordBreak="true" text="You want everything live, you want things you can touch" fontFile="/font/Inter24pt-Medium.ttf" fontSize="20" zIndex="1" />
                </hg_list_item>
                <hg_list_item id="hg_list_lyrics_item_5" x="0" y="300" width="200" height="60" index="5" zIndex="5">
                    <hg_label id="hg_label_lyrics_5" x="0" y="10" width="200" height="45" hAlign="LEFT" vAlign="TOP" color="#ffffff" letterSpacing="0" lineSpacing="3" wordWrap="true" wordBreak="true" text="Make it feel like a movie you saw in your youth" fontFile="/font/Inter24pt-Medium.ttf" fontSize="20" zIndex="1" />
                </hg_list_item>
                <hg_list_item id="hg_list_lyrics_item_6" x="0" y="360" width="200" height="60" index="6" zIndex="6">
                    <hg_label id="hg_label_lyrics_6" x="0" y="10" width="200" height="45" hAlign="LEFT" vAlign="TOP" color="#ffffff" letterSpacing="0" lineSpacing="3" wordWrap="true" wordBreak="true" text="Make it feel like that song that just unopened you" fontFile="/font/Inter24pt-Medium.ttf" fontSize="20" zIndex="1" />
                </hg_list_item>
            </hg_list>
            <hg_window id="hg_window_music_controls" x="0" y="269" width="480" height="51" showBackground="false" backgroundColor="#808080" enableBlur="true" blurDegree="225" zIndex="5">
                <hg_image id="hg_image_music_bar" x="27" y="0" width="426" height="40" src="assets/music/music_bar.png" blendMode="IMG_SRC_OVER_MODE" zIndex="2" />
                <hg_image id="hg_image_music_forward" x="60" y="13" width="24" height="14" src="assets/music/music_forward.png" blendMode="IMG_SRC_OVER_MODE" zIndex="3" />
                <hg_image id="hg_image_music_pause" x="121" y="11" width="14" height="18" src="assets/music/music_pause.png" blendMode="IMG_SRC_OVER_MODE" zIndex="4" />
                <hg_image id="hg_image_music_backward" x="170" y="13" width="24" height="14" src="assets/music/music_backward.png" blendMode="IMG_SRC_OVER_MODE" zIndex="5" />
                <hg_image id="hg_image_music_quote" x="293" y="11" width="20" height="20" src="assets/music/music_quote.png" blendMode="IMG_SRC_OVER_MODE" zIndex="6" />
                <hg_image id="hg_image_music_list" x="351" y="13" width="20" height="15" src="assets/music/music_list.png" blendMode="IMG_SRC_OVER_MODE" zIndex="7" />
                <hg_image id="hg_image_music_speaker" x="403" y="13" width="20" height="15" src="assets/music/music_speaker.png" blendMode="IMG_SRC_OVER_MODE" zIndex="8" />
            </hg_window>
        </hg_view>
    </view>
</hml>