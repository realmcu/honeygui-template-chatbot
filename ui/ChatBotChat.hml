<?xml version="1.0" encoding="UTF-8"?>
<hml>
    <meta>
        <project name="ChatBotMain" appId="com.honeygui.chatbot" resolution="480X320" minSdk="API 2: HoneyGUI V1.1.0" pixelMode="ARGB8888" />
        <author name="HoneyGUI Design" />
    </meta>
    <view>
        <hg_view id="ChatBotChatView" x="0" y="0" width="480" height="320" backgroundColor="#000000" entry="true" zIndex="0">
            <hg_rect id="headerBg" x="0" y="0" width="480" height="50" fillColor="#4A90E2" borderRadius="0" zIndex="0" />
            <hg_label id="headerTitle" x="50" y="12" width="380" height="26" color="#FFFFFF" hAlign="CENTER" vAlign="MID" text="AI Assistant" fontSize="20" fontFile="/font/sf_compact_text_medium.otf" fontType="bitmap" zIndex="1" />
            <hg_rect id="chatAreaBg" x="0" y="50" width="480" height="220" fillColor="#F5F7FA" borderRadius="0" zIndex="2" />
            <hg_rect id="botBubble1Bg" x="15" y="65" width="300" height="50" fillColor="#E8EEF5" borderRadius="12" zIndex="3" />
            <hg_label id="botText1" x="65" y="70" width="240" height="40" color="#2C3E50" wordWrap="true" vAlign="MID" text="Hello! How can I help you today?" fontSize="16" fontFile="/font/sf_compact_text_light.otf" fontType="bitmap" zIndex="4" />
            <hg_rect id="userBubble1Bg" x="165" y="135" width="300" height="50" fillColor="#4A90E2" borderRadius="12" zIndex="5" />
            <hg_label id="userText1" x="180" y="145" width="240" height="30" color="#FFFFFF" wordWrap="true" vAlign="MID" text="What&#39;s the weather like?" fontSize="16" fontFile="/font/sf_compact_text_light.otf" fontType="bitmap" zIndex="6" />
            <hg_rect id="botBubble2Bg" x="15" y="195" width="260" height="50" fillColor="#E8EEF5" borderRadius="12" zIndex="7" />
            <hg_label id="botText2" x="65" y="210" width="200" height="20" color="#2C3E50" vAlign="MID" text="It&#39;s sunny and 22°C." fontSize="16" fontFile="/font/sf_compact_text_light.otf" fontType="bitmap" zIndex="8" />
            <hg_rect id="inputBarBg" x="0" y="270" width="480" height="50" fillColor="#FFFFFF" borderRadius="0" zIndex="9" />
            <hg_rect id="voiceMicIcon" x="23" y="286" width="6" height="10" fillColor="#FFFFFF" borderRadius="3" zIndex="10" />
            <hg_rect id="voiceMicStand" x="25" y="296" width="2" height="4" fillColor="#FFFFFF" borderRadius="0" zIndex="11" />
            <hg_rect id="voiceMicBase" x="23" y="300" width="6" height="2" fillColor="#FFFFFF" borderRadius="1" zIndex="12" />
            <hg_rect id="inputBoxBg" x="55" y="280" width="340" height="30" fillColor="#F0F0F0" borderRadius="15" zIndex="13" />
            <hg_label id="inputPlaceholder" x="70" y="287" width="310" height="16" color="#999999" vAlign="MID" text="Type a message..." fontSize="14" fontFile="/font/sf_compact_text_medium.otf" fontType="bitmap" zIndex="14" />
            <hg_rect id="sendBtnBg" x="405" y="280" width="60" height="30" fillColor="#4A90E2" borderRadius="15" zIndex="15" />
            <hg_label id="sendBtnText" x="420" y="287" width="30" height="16" color="#FFFFFF" hAlign="CENTER" vAlign="MID" text="Send" fontSize="14" fontFile="/font/sf_compact_text_semibold.otf" fontType="bitmap" zIndex="16" />
            <hg_image id="hg_image_1768902084122_gugh" x="11" y="278" width="35" height="35" src="assets/chat/mic.png" zIndex="17">
                <events>
                    <event type="onClick">
                        <action type="switchView" target="ChatBotVoiceInputView" switchOutStyle="SWITCH_OUT_ANIMATION_FADE" switchInStyle="SWITCH_IN_ANIMATION_FADE" />
                    </event>
                </events>
            </hg_image>
            <hg_image id="hg_image_1768902472844_8i52" x="17" y="15" width="11" height="20" src="assets/chat/return.png" zIndex="18">
                <events>
                    <event type="onClick">
                        <action type="switchView" target="ChatBotTemplateMainView" switchOutStyle="SWITCH_OUT_ANIMATION_FADE" switchInStyle="SWITCH_IN_ANIMATION_FADE" />
                    </event>
                </events>
            </hg_image>
            <hg_image id="hg_image_1768902485540_kaad" x="26" y="74" width="32" height="32" src="assets/chat/general_robot.png" zIndex="19" />
            <hg_image id="hg_image_1768902502036_7zrb" x="424" y="145" width="30" height="30" src="assets/chat/user.png" zIndex="20" />
            <hg_image id="hg_image_1768902511432_v9ml" x="26" y="203" width="32" height="32" src="assets/chat/general_robot.png" zIndex="21" />
        </hg_view>
    </view>
</hml>