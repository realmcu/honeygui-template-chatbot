<?xml version="1.0" encoding="UTF-8"?>
<hml>
    <meta>
        <project name="app_calendar" appId="com.honeygui.chatbot" resolution="480X320" minSdk="API 2: HoneyGUI V1.1.0" pixelMode="ARGB8888" />
        <author name="Anonymous" />
    </meta>
    <view>
        <hg_view id="app_calendarView" x="0" y="0" width="480" height="320" backgroundColor="#000000" entry="false" zIndex="0">
            <events>
                <event type="onKeyShortPress" keyName="Home">
                    <action type="switchView" target="ChatBotTemplateMainView" switchOutStyle="SWITCH_OUT_ANIMATION_FADE" switchInStyle="SWITCH_IN_ANIMATION_FADE" />
                </event>
                <event type="onKeyShortPress" keyName="Menu">
                    <action type="switchView" target="ChatBotFeaturesView" switchOutStyle="SWITCH_OUT_ANIMATION_FADE" switchInStyle="SWITCH_IN_ANIMATION_FADE" />
                </event>
            </events>
            <hg_window id="win_header" x="0" y="0" width="480" height="44" showBackground="true" backgroundColor="#000000" zIndex="1">
                <hg_label id="lbl_arrow_left" x="16" y="11" width="16" height="22" hAlign="CENTER" vAlign="MID" color="#FFFFFF" letterSpacing="0" lineSpacing="0" wordWrap="false" wordBreak="false" text="&lt;" fontFile="/font/Inter24pt-Medium.ttf" fontSize="20" zIndex="3" />
                <hg_label id="lbl_month_year" x="100" y="10" width="280" height="24" hAlign="CENTER" vAlign="MID" color="#FFFFFF" letterSpacing="0" lineSpacing="0" wordWrap="false" wordBreak="false" text="April 2026" fontFile="/font/Inter24pt_SemiBold.ttf" fontSize="22" fontType="vector" zIndex="2" />
