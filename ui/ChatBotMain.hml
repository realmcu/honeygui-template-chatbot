<?xml version="1.0" encoding="UTF-8"?>
<hml>
    <meta>
        <project name="WelcomeScreen" appId="com.honeygui.chatbot" resolution="480X320" minSdk="API 2: HoneyGUI V1.1.0" pixelMode="ARGB8888" />
        <author name="HoneyGUI Design" />
    </meta>
    <view>
        <hg_view id="ChatBotTemplateMainView" x="202" y="0" width="480" height="320" backgroundColor="#000000" entry="true" zIndex="0">
            <events>
                <event type="onSwipeLeft">
                    <action type="switchView" target="ChatBotFeaturesView" switchOutStyle="SWITCH_OUT_TO_LEFT_USE_TRANSLATION" switchInStyle="SWITCH_IN_FROM_RIGHT_USE_TRANSLATION" />
                </event>
                <event type="onClick">
                    <action type="switchView" target="ChatBotChatView" switchOutStyle="SWITCH_INIT_STATE" switchInStyle="SWITCH_IN_ANIMATION_FADE" />
                </event>
                <event type="onSwipeDown">
                    <action type="switchView" target="ChatBotTopView" switchOutStyle="SWITCH_OUT_STILL_USE_BLUR" switchInStyle="SWITCH_IN_FROM_TOP_USE_TRANSLATION" />
                </event>
            </events>
            <hg_image id="hg_image_mainview_bg" x="105" y="82" width="135" height="80" transform="{&quot;scaleX&quot;:2,&quot;scaleY&quot;:2}" src="assets/main_view/bg.png" zIndex="0" />
            <hg_rect id="hg_rect_rightEyeOuter" x="265" y="105" width="90" height="110" borderRadius="40" fillColor="#FFFFFF" opacity="255" useGradient="true" gradientDirection="vertical" gradientStops="[{&quot;position&quot;:0,&quot;color&quot;:&quot;#ffffff&quot;},{&quot;position&quot;:1,&quot;color&quot;:&quot;#3c8bbb&quot;}]" timers="[{&quot;id&quot;:&quot;timer_0&quot;,&quot;name&quot;:&quot;动画 1&quot;,&quot;enabled&quot;:true,&quot;interval&quot;:17,&quot;reload&quot;:true,&quot;mode&quot;:&quot;custom&quot;,&quot;callback&quot;:&quot;eye_animation_callback&quot;,&quot;duration&quot;:1000,&quot;stopOnComplete&quot;:true,&quot;delayStart&quot;:0,&quot;actions&quot;:[],&quot;segments&quot;:[]}]" zIndex="1" />
            <hg_time_label id="hg_time_label_time" x="165" y="10" width="150" height="35" hAlign="CENTER" vAlign="MID" color="#FFFFFF" letterSpacing="0" lineSpacing="0" wordWrap="false" timeFormat="HH:mm" characterSets="[{&quot;type&quot;:&quot;string&quot;,&quot;value&quot;:&quot;0123456789:- &quot;}]" fontFile="/font/Inter24pt-Medium.ttf" fontSize="32" zIndex="2" />
            <hg_rect id="hg_rect_leftEyeOuter" x="123" y="105" width="90" height="110" borderRadius="40" fillColor="#FFFFFF" opacity="255" useGradient="true" gradientDirection="vertical" gradientStops="[{&quot;position&quot;:0,&quot;color&quot;:&quot;#ffffff&quot;},{&quot;position&quot;:1,&quot;color&quot;:&quot;#3c8bbb&quot;}]" timers="[{&quot;id&quot;:&quot;timer_0&quot;,&quot;name&quot;:&quot;动画 1&quot;,&quot;enabled&quot;:true,&quot;interval&quot;:17,&quot;reload&quot;:true,&quot;mode&quot;:&quot;custom&quot;,&quot;callback&quot;:&quot;eye_animation_callback&quot;,&quot;duration&quot;:1000,&quot;stopOnComplete&quot;:true,&quot;delayStart&quot;:0,&quot;actions&quot;:[],&quot;segments&quot;:[]}]" zIndex="3" />
            <hg_rect id="hg_rect_emotionButton" x="140" y="261" width="200" height="40" borderRadius="0" fillColor="#161717" opacity="255" useGradient="false" gradientDirection="horizontal" zIndex="1">
                <events>
                    <event type="onClick">
                        <action type="callFunction" functionName="hg_rect_emotionButton_onClick" />
                    </event>
                </events>
            </hg_rect>
            <hg_label id="hg_label_emotionLabel" x="140" y="261" width="200" height="40" hAlign="CENTER" vAlign="MID" color="#ffffff" letterSpacing="0" lineSpacing="0" wordWrap="false" wordBreak="false" text="Normal" fontFile="/font/Inter24pt-Medium.ttf" fontSize="20" characterSets="[{&quot;type&quot;:&quot;range&quot;,&quot;value&quot;:&quot;0x20-0x7E&quot;}]" zIndex="1" />
            <hg_arc id="hg_arc_left" x="73" y="56" width="190" height="190" radius="80" startAngle="240" endAngle="300" strokeWidth="15" color="#ffffff" opacity="255" useGradient="false" zIndex="1" />
            <hg_arc id="hg_arc_right" x="214" y="56" width="190" height="190" radius="80" startAngle="240" endAngle="300" strokeWidth="15" color="#ffffff" opacity="255" useGradient="false" zIndex="1" />
            <hg_image id="hg_image_main_wifi" x="16" y="16" width="24" height="24" src="assets/main_view/wifi.png" zIndex="4" />
            <hg_image id="hg_image_main_battery" x="440" y="16" width="24" height="24" src="assets/main_view/battery.png" zIndex="5" />
        </hg_view>
        <hg_view id="ChatBotTopView" x="202" y="-547" width="480" height="320" backgroundColor="#000000" borderRadius="0" padding="0" overflow="auto" entry="false" zIndex="1">
            <events>
                <event type="onSwipeUp">
                    <action type="switchView" target="ChatBotTemplateMainView" switchOutStyle="SWITCH_OUT_TO_TOP_USE_TRANSLATION" switchInStyle="SWITCH_IN_STILL_USE_BLUR" />
                </event>
            </events>
            <hg_list id="hg_list_notification" x="0" y="0" width="480" height="320" itemWidth="480" itemHeight="100" space="0" direction="VERTICAL" style="LIST_CARD" cardStackLocation="20" noteNum="5" offset="0" outScope="0" autoAlign="false" inertia="true" loop="false" createBar="false" enableAreaDisplay="false" keepNoteAlive="false" showOverflow="true" zIndex="1" showOverflow="true">
                <hg_list_item id="hg_list_notification_item_0" x="0" y="0" width="480" height="100" index="0" zIndex="0">
                    <hg_rect id="hg_rect_notification_1_bg" x="20" y="8" width="440" height="85" borderRadius="16" fillColor="#c1cad7" opacity="255" useGradient="false" gradientDirection="vertical" gradientStops="[{&quot;position&quot;:0,&quot;color&quot;:&quot;#1E293B&quot;},{&quot;position&quot;:1,&quot;color&quot;:&quot;#0F172A&quot;}]" zIndex="1">
                        <events>
                            <event type="onClick">
                                <action type="switchView" target="app_weatherView" switchOutStyle="SWITCH_OUT_ANIMATION_FADE" switchInStyle="SWITCH_IN_ANIMATION_FADE" />
                            </event>
                        </events>
                    </hg_rect>
                    <hg_image id="img_42" x="35" y="26" width="50" height="50" src="assets/feature/app_weather_icon.png" zIndex="11" />
                    <hg_label id="hg_label_notification_1_title" x="105" y="20" width="250" height="24" hAlign="LEFT" vAlign="MID" color="#000000" letterSpacing="0" lineSpacing="0" wordWrap="false" wordBreak="false" text="Weather Alert" fontFile="/font/Inter24pt_SemiBold.ttf" fontSize="18" zIndex="2" />
                    <hg_label id="hg_label_notification_1_content" x="105" y="45" width="320" height="20" hAlign="LEFT" vAlign="MID" color="#000000" letterSpacing="0" lineSpacing="0" wordWrap="false" wordBreak="false" text="Sunny, 22°C - Perfect day ahead!" fontFile="/font/sf_compact_regular.otf" fontSize="14" zIndex="2" />
                    <hg_label id="hg_label_notification_1_time" x="105" y="65" width="100" height="18" hAlign="LEFT" vAlign="MID" color="#000000" letterSpacing="0" lineSpacing="0" wordWrap="false" wordBreak="false" text="5 min ago" fontFile="/font/sf_compact_regular.otf" fontSize="12" zIndex="2" />
                </hg_list_item>
                <hg_list_item id="hg_list_notification_item_1" x="0" y="100" width="480" height="100" index="1" zIndex="1">
                    <hg_rect id="hg_rect_notification_2_bg" x="20" y="8" width="440" height="85" borderRadius="16" fillColor="#c1cad7" opacity="255" useGradient="false" gradientDirection="vertical" zIndex="1">
                        <events>
                            <event type="onClick">
                                <action type="switchView" target="app_musicView" switchOutStyle="SWITCH_OUT_ANIMATION_FADE" switchInStyle="SWITCH_IN_ANIMATION_FADE" />
                            </event>
                        </events>
                    </hg_rect>
                    <hg_image id="hg_image_notification_2_icon" x="35" y="26" width="50" height="50" src="assets/feature/app_music_icon.png" zIndex="11" />
                    <hg_label id="hg_label_notification_2_title" x="105" y="20" width="250" height="24" hAlign="LEFT" vAlign="MID" color="#000000" letterSpacing="0" lineSpacing="0" wordWrap="false" wordBreak="false" text="Now Playing" fontFile="/font/Inter24pt_SemiBold.ttf" fontSize="18" zIndex="2" />
                    <hg_label id="hg_label_notification_2_content" x="105" y="45" width="320" height="20" hAlign="LEFT" vAlign="MID" color="#000000" letterSpacing="0" lineSpacing="0" wordWrap="false" wordBreak="false" text="Relaxing Jazz - Smooth Vibes" fontFile="/font/Inter_24pt_Regular.ttf" fontSize="14" zIndex="2" />
                    <hg_label id="hg_label_notification_2_time" x="105" y="65" width="100" height="18" hAlign="LEFT" vAlign="MID" color="#000000" letterSpacing="0" lineSpacing="0" wordWrap="false" wordBreak="false" text="15 min ago" fontFile="/font/sf_compact_regular.otf" fontSize="12" zIndex="2" />
                </hg_list_item>
                <hg_list_item id="hg_list_notification_item_2" x="0" y="200" width="480" height="100" index="2" zIndex="2">
                    <hg_rect id="hg_rect_notification_3_bg" x="20" y="8" width="440" height="85" borderRadius="16" fillColor="#c1cad7" opacity="255" useGradient="false" gradientDirection="vertical" zIndex="1" />
                    <hg_image id="hg_image_notification_3_icon" x="35" y="26" width="50" height="50" src="assets/feature/app_reminders_icon.png" zIndex="11" />
                    <hg_label id="hg_label_notification_3_title" x="105" y="20" width="250" height="24" hAlign="LEFT" vAlign="MID" color="#000000" letterSpacing="0" lineSpacing="0" wordWrap="false" wordBreak="false" text="Reminder" fontFile="/font/Inter24pt_SemiBold.ttf" fontSize="18" zIndex="2" />
                    <hg_label id="hg_label_notification_3_content" x="105" y="45" width="320" height="20" hAlign="LEFT" vAlign="MID" color="#000000" letterSpacing="0" lineSpacing="0" wordWrap="false" wordBreak="false" text="Team meeting at 3:00 PM" fontFile="/font/sf_compact_regular.otf" fontSize="14" zIndex="2" />
                    <hg_label id="hg_label_notification_3_time" x="105" y="65" width="100" height="18" hAlign="LEFT" vAlign="MID" color="#000000" letterSpacing="0" lineSpacing="0" wordWrap="false" wordBreak="false" text="1 hour ago" fontFile="/font/sf_compact_regular.otf" fontSize="12" zIndex="2" />
                </hg_list_item>
                <hg_list_item id="hg_list_notification_item_3" x="0" y="300" width="480" height="100" index="3" zIndex="3">
                    <hg_rect id="hg_rect_notification_4_bg" x="20" y="8" width="440" height="85" borderRadius="16" fillColor="#c1cad7" opacity="255" useGradient="false" gradientDirection="vertical" zIndex="1">
                        <events>
                            <event type="onClick">
                                <action type="switchView" target="ChatBotSettingsView" switchOutStyle="SWITCH_OUT_ANIMATION_FADE" switchInStyle="SWITCH_IN_ANIMATION_FADE" />
                            </event>
                        </events>
                    </hg_rect>
                    <hg_image id="hg_image_notification_4_icon" x="35" y="26" width="50" height="50" src="assets/feature/app_calendar_icon.png" blendMode="IMG_SRC_OVER_MODE" zIndex="11" />
                    <hg_label id="hg_label_notification_4_title" x="105" y="20" width="250" height="24" hAlign="LEFT" vAlign="MID" color="#000000" letterSpacing="0" lineSpacing="0" wordWrap="false" wordBreak="false" text="Calendar Event" fontFile="/font/Inter24pt_SemiBold.ttf" fontSize="18" zIndex="2" />
                    <hg_label id="hg_label_notification_4_content" x="105" y="45" width="320" height="20" hAlign="LEFT" vAlign="MID" color="#000000" letterSpacing="0" lineSpacing="0" wordWrap="false" wordBreak="false" text="Project review tomorrow 10 AM" fontFile="/font/sf_compact_regular.otf" fontSize="14" zIndex="2" />
                    <hg_label id="hg_label_notification_4_time" x="105" y="65" width="100" height="18" hAlign="LEFT" vAlign="MID" color="#000000" letterSpacing="0" lineSpacing="0" wordWrap="false" wordBreak="false" text="2 hours ago" fontFile="/font/sf_compact_regular.otf" fontSize="12" zIndex="2" />
                </hg_list_item>
                <hg_list_item id="hg_list_notification_item_4" x="0" y="400" width="480" height="100" index="4" zIndex="4">
                    <hg_rect id="hg_rect_notification_5_bg" x="20" y="8" width="440" height="85" borderRadius="16" fillColor="#c1cad7" opacity="255" useGradient="false" gradientDirection="vertical" zIndex="1" />
                    <hg_image id="hg_image_notification_5_icon" x="35" y="26" width="50" height="50" src="assets/feature/app_news_icon.png" zIndex="11" />
                    <hg_label id="hg_label_notification_5_title" x="105" y="20" width="250" height="24" hAlign="LEFT" vAlign="MID" color="#000000" letterSpacing="0" lineSpacing="0" wordWrap="false" wordBreak="false" text="News Update" fontFile="/font/Inter24pt_SemiBold.ttf" fontSize="18" zIndex="2" />
                    <hg_label id="hg_label_notification_5_content" x="105" y="45" width="320" height="20" hAlign="LEFT" vAlign="MID" color="#000000" letterSpacing="0" lineSpacing="0" wordWrap="false" wordBreak="false" text="5 new articles in Technology" fontFile="/font/sf_compact_regular.otf" fontSize="14" zIndex="2" />
                    <hg_label id="hg_label_notification_5_time" x="105" y="65" width="100" height="18" hAlign="LEFT" vAlign="MID" color="#000000" letterSpacing="0" lineSpacing="0" wordWrap="false" wordBreak="false" text="3 hours ago" fontFile="/font/sf_compact_regular.otf" fontSize="12" zIndex="2" />
                </hg_list_item>
            </hg_list>
        </hg_view>
    </view>
</hml>